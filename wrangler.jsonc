{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salon-reservation-oss",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["OWNER_TOKEN", "TURNSTILE_SECRET"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/api/*", "/line", "/line/", "/line.html", "/line-link.mjs", "/line-liff.mjs", "/privacy.html"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESERVATION_DAYS",
        "class_name": "ReservationDay"
      },
      {
        "name": "INSTALLATION_CONFIG",
        "class_name": "InstallationConfig"
      },
      {
        "name": "ADAPTER_DELIVERY",
        "class_name": "AdapterDelivery"
      }
    ]
  },
  "exports": {
    "ReservationDay": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "InstallationConfig": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    // Optional LINE adapter delivery authority. Never delete this entry as
    // part of a rollback: dropping it alone preserves the namespace and its
    // stored data; a "deleted" tombstone would destroy both. See
    // specs/003-line-adapter/research.md R5 and docs/RELEASING.md.
    "AdapterDelivery": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "81740354",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "OWNER_RATE_LIMITER",
      "namespace_id": "72597735",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
